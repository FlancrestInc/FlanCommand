NODE_ENV=development
HERMES_ENDPOINT=ws://127.0.0.1:9119/api/ws
HERMES_ORIGIN=http://127.0.0.1:3000
# Create one strong shared secret and set it on the Hermes gateway as
# HERMES_DASHBOARD_SESSION_TOKEN. Inject the same value here at runtime.
# Never commit the token. HERMES_AUTH_REF is only a secret-store label.
HERMES_AUTH_TOKEN=
HERMES_AUTH_REF=
# Hermes v0.19 gated dashboard login. Set both, or leave both blank to use
# HERMES_AUTH_TOKEN query authentication on older or loopback Hermes servers.
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
# Bounded receive size for large Hermes session history frames (1-32 MiB).
HERMES_MAX_FRAME_BYTES=8388608
PROBE_OUTPUT_DIR=probe-output
PROBE_CONNECT_TIMEOUT_MS=5000
PROBE_REQUEST_TIMEOUT_MS=10000
PROBE_IDLE_TIMEOUT_MS=30000
PROBE_TOTAL_TIMEOUT_MS=120000
PROBE_MAX_FRAME_BYTES=8388608
PROBE_MAX_TRANSCRIPT_BYTES=10485760
PROBE_MAX_EVENTS=500
FLANC_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional comma-separated browser origins for state-changing API requests.
FLANC_ALLOWED_ORIGINS=
# Require the trusted identity header supplied by Cloudflare Access in deployment.
FLANC_REQUIRE_AUTH=false
FLANC_AUTH_IDENTITY_HEADER=cf-access-authenticated-user-email
# Per-client rate-limit window and request count for high-risk mutations.
FLANC_RATE_LIMIT_WINDOW_MS=60000
FLANC_RATE_LIMIT_MAX=60
FLANC_MAX_CONCURRENT_JOBS=2
FLANC_APPROVAL_SIGNING_SECRET=replace-with-a-long-random-value
FLANC_NTFY_TOPIC=
FLANC_NTFY_BASE_URL=https://ntfy.sh
FLANC_APPRISE_URL=
FLANC_APPRISE_KEY=
BWS_ACCESS_TOKEN=
PROBE_MAX_TEST_SESSIONS=1
